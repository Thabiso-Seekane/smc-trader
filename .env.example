MT5_LOGIN=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server

DEFAULT_SYMBOL=XAUUSD
DEFAULT_TIMEFRAME=M15
CANDLES_TO_DOWNLOAD=5000
RISK_PERCENT=1.0
MINIMUM_CONFLUENCE=70
MINIMUM_RISK_REWARD=2.0
MINIMUM_DISPLACEMENT=0
REQUIRE_LIQUIDITY_SWEEP=false
PREMIUM_DISCOUNT_MATCH=false

# Live execution is fail-closed. Do not enable until the out-of-sample
# readiness report passes and you explicitly accept real-money risk.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_RISK_ACKNOWLEDGEMENT=
LIVE_MAX_MARGIN_FRACTION=0.25
LIVE_MAX_DEVIATION_POINTS=20
LIVE_ORDER_COMMENT=smc_trader

LOG_LEVEL=INFO
LOG_DIRECTORY=logs
DATA_DIRECTORY=data_store
